rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Profiles collection - users can only read/write their own profile
    match /profiles/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Habits collection - users can read/write their own habits
    match /habits/{habitId} {
      allow read: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid || 
        resource.data.user_id == null
      );
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
    }
    
    // Habit completions - users can only read/write their own completions
    match /habit_completions/{completionId} {
      allow read, write: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid ||
        request.resource.data.user_id == request.auth.uid
      );
    }
    
    // Streaks - users can only read/write their own streaks
    match /streaks/{streakId} {
      allow read, write: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid ||
        request.resource.data.user_id == request.auth.uid
      );
    }
  }
}
